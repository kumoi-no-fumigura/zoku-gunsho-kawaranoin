 "blocks": [
  {
   "id": "zoku-gunsho-kawaranoin-0001",
   "pid": "nao-734209",
   "pages": [
    1
   ],
   "text": "一みみりまたおもひのことに夏虫のなれてすへにもたのむなくにす夏虫のわかたましひにみをかつくし心とことにこかれけるかなお九月五日庚申夜河原院歌合廿首一番霜鶴立洲左あしたつのたてるなきさのかはへにはちよをかす右かつ一見えてみき有にたてかたつはみなかへこるよを思なるへし二番翠松臨池左かつも伊け水に松のみとりのそめぬれはいとゝふかさのそこもしられす",
   "poems": [
    "1",
    "2",
    "3",
    "4",
    "5"
   ]
  },
  {
   "id": "zoku-gunsho-kawaranoin-0002",
   "pid": "nao-734209",
   "pages": [
    2
   ],
   "text": "たれにとかいけのこゝろも思らんそらにやとれる松はちとせを三番振雁関雲たかちくさまくら我こそたひに露けけれ其程にきこゆる雁のこゑ哉右行とくと愛ちをなるすかりかねのつねのたひとは思はさえ南四番夜虫鳴蓑左あきのゝのくさはつゆにそほとへつゝ鳴虫のねにわれもおとらす七歌闕五番花薄拾人左特花すゞきまねくたもとのあまたあれはゆきもやられす秋の野の道右はなすゝきまねくたもとやたゆからんはかるのかせにかへかへる人なみ六番秋萩鳴鹿左おなくしかのなみたなるへし秋野のゝはきのつゆはことにみゆるは",
   "poems": [
    "6",
    "7",
    "8",
    "9",
    "10",
    "11",
    "12"
   ]
  },
  {
   "id": "zoku-gunsho-kawaranoin-0003",
   "pid": "nao-734209",
   "pages": [
    3
   ],
   "text": "ゑのちよりものゝふはきにいとゝしくしかのねをさへなきてきるする七番露光宿菊左しらつゆのやとりし時はしろかりしきくはいかてかいろのことなるかさしにはをかまほしきをしらきくの花に屋とれるつゆやこほれん右八番月景漏屋左持あめならぬとしのふるにもわかやとは月もるはかりあれにけるかな右月もりてあれたるやとのあひたにはいつれをあすのあくるとかせむ九番花生坂薄露深左勝ほかよりてたちやそふらんあききりのうりふのさかにくらくもあるかな七なに高くなりいしぬれとうりふさかきりのみたそとみゑともあるかな十番佐保山紅葉浅草左さをひめにとひ見てしかなわきてしもはゝそのもみちかすゝ心を右勝",
   "poems": [
    "13",
    "14",
    "15",
    "16",
    "17",
    "18",
    "19",
    "20"
   ]
  },
  {
   "id": "zoku-gunsho-kawaranoin-0004",
   "pid": "nao-734209",
   "pages": [
    4
   ],
   "text": "さほひめのなたてにこきもみちこあたりのかせの吹ちらさなん御伝来多弐峯歌合河原院歌合千代君歌合右一巻者小野宮忠家卿真跡但世俊成卿祖父定家卿曽祖父にて到る古代之真筆にて定家卿小倉色紙よりも遥に珍書と冷泉為村郷も賞候ニ御座候高松弾正尹好仁親王御重宝ニ御座候其より花町式部卿良仁親王御伝御重宝ニ御座候其より",
   "poems": [
    "21"
   ]
  },
  {
   "id": "zoku-gunsho-kawaranoin-0005",
   "pid": "nao-734209",
   "pages": [
    5
   ],
   "text": "有栖川兵部卿幸仁親王ニ御つたへ其より背栖一同一品中務卿織仁親王江御伝来ニ明和五年紫野大徳寺寂厳和尚へ御伝へ御座候ヲ中川主税頭豊島大舎人頭両人より世界之名物と申事にて達而申受候其より亡父左兵衛尉伝来仕罷在候候以上多武峰往生院千世君歌合題涼風入簾閑山秋月藪露為玉野花錦延水有幽音恋歌人右仁昭長昭千世君恵勝長嚴長暹左静範明・成厳修勝泉園覚暹判者",
   "poems": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "一みみりまたおもひのことに夏虫のなれてすへにもたのむなくにす",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": ""
  },
  {
   "seq": "2",
   "text": "夏虫のわかたましひにみをかつくし心とことにこかれけるかな",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": ""
  },
  {
   "seq": "3",
   "text": "あしたつのたてるなきさのかはへにはちよをかす",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "4",
   "text": "一見えてみき有にたてかたつはみなかへこるよを思なるへし",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "右",
   "dai": "かつ"
  },
  {
   "seq": "5",
   "text": "伊け水に松のみとりのそめぬれはいとゝふかさのそこもしられす",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "左",
   "dai": "かつ"
  },
  {
   "seq": "6",
   "text": "たれにとかいけのこゝろも思らんそらにやとれる松はちとせを",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "",
   "dai": "かつ"
  },
  {
   "seq": "7",
   "text": "くさまくら我こそたひに露けけれ其程にきこゆる雁のこゑ哉",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "",
   "dai": ""
  },
  {
   "seq": "8",
   "text": "行とくと愛ちをなるすかりかねのつねのたひとは思はさえ南",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "9",
   "text": "あきのゝのくさはつゆにそほとへつゝ鳴虫のねにわれもおとらす",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "10",
   "text": "花すゞきまねくたもとのあまたあれはゆきもやられす秋の野の道",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "左",
   "dai": "特"
  },
  {
   "seq": "11",
   "text": "はなすゝきまねくたもとやたゆからんはかるのかせにかへかへる人なみ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "右",
   "dai": "特"
  },
  {
   "seq": "12",
   "text": "なくしかのなみたなるへし秋野のゝはきのつゆはことにみゆるは",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "13",
   "text": "ゑのちよりものゝふはきにいとゝしくしかのねをさへなきてきるする",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "",
   "dai": ""
  },
  {
   "seq": "14",
   "text": "しらつゆのやとりし時はしろかりしきくはいかてかいろのことなる",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "15",
   "text": "かさしにはをかまほしきをしらきくの花に屋とれるつゆやこほれん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "",
   "dai": ""
  },
  {
   "seq": "16",
   "text": "あめならぬとしのふるにもわかやとは月もるはかりあれにけるかな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "17",
   "text": "月もりてあれたるやとのあひたにはいつれをあすのあくるとかせむ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "右",
   "dai": "持"
  },
  {
   "seq": "18",
   "text": "ほかよりてたちやそふらんあききりのうりふのさかにくらくもあるかな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "19",
   "text": "なに高くなりいしぬれとうりふさかきりのみたそとみゑともあるかな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "",
   "dai": "勝"
  },
  {
   "seq": "20",
   "text": "さをひめにとひ見てしかなわきてしもはゝそのもみちかすゝ心を",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "21",
   "text": "さほひめのなたてにこきもみちこあたりのかせの吹ちらさなん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "右",
   "dai": "勝"
  }
 ],
